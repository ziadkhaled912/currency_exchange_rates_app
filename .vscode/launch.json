    "version": "0.2.0",
    "configurations": [
        {
            "name": "currency_exchange developement mode",
            "request": "launch",
            "type": "dart",
            "program": "lib/main/main_development.dart",
            "args": ["--target", "lib/main/main_development.dart",]
        },
        {
            "name": "currency_exchange production mode",
            "request": "launch",
            "type": "dart",
            "program": "lib/main/main_production.dart",
            "args": ["--target", "lib/main/main_production.dart", "--flavor", "production" ]
        },
        {
            "name": "currency_exchange (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}